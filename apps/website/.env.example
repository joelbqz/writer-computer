# Copy to apps/website/.env to send analytics from a local build.
# Both are read at build time. With no key the site is inert: PostHog is never
# initialized and nothing is sent. See docs/website-analytics.md.

# Public PostHog project key (a `phc_...` value — publishable, not a secret).
VITE_POSTHOG_KEY=

# Ingestion host. Defaults to https://us.i.posthog.com when unset.
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
